[Unit]
Description=Infra Highway tunnel for OpenCode web
After=network-online.target opencode-web.service
Wants=network-online.target
Requires=opencode-web.service

[Service]
Type=simple
ExecStart=/usr/local/bin/infra highway http 4096
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
